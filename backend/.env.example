# SQLite database file, created in the backend working directory.
DATABASE_URL=sqlite:///./event_booking.db

# Comma-separated frontend origins allowed to call the API from browsers.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate a unique value with: openssl rand -hex 32
# Do not use a shared/default value in production.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15